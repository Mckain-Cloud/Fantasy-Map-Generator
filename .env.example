# OpenRouter API Key for AI Map Editor
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vendor keys are optional: a model is routed to its vendor when the key exists,
# otherwise through OpenRouter (which can serve every model in the registry).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: route these vendors through OpenRouter even when their key is set (all | anthropic | openai)
# AI_PREFER_OPENROUTER=anthropic
