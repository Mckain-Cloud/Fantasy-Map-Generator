{
  "name": "fantasy-map-generator",
  "version": "1.108.1",
  "description": "Azgaar's Fantasy Map Generator - Automated Test Suite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "playwright test",
    "test:unit": "playwright test tests/unit",
    "test:unit:ai": "vitest run modules/ai",
    "test:unit:ai:watch": "vitest modules/ai",
    "test:integration": "playwright test tests/integration",
    "test:e2e": "playwright test tests/e2e",
    "test:performance": "playwright test tests/performance",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:coverage": "COLLECT_COVERAGE=true playwright test",
    "test:report": "playwright show-report",
    "serve": "python -m http.server 8080",
    "test:watch": "playwright test --ui",
    "test:fast": "vitest run",
    "test:fast:watch": "vitest",
    "test:e2e:fast": "playwright test tests/e2e",
    "test:world-spec": "playwright test tests/e2e/world-spec-applicator.spec.js tests/e2e/world-spec-fidelity.spec.js",
    "test:audit": "playwright test tests/e2e/world-spec-fidelity-audit.spec.js",
    "ai:sweep": "node scripts/world-spec-model-sweep.mjs",
    "test:sweep": "playwright test tests/e2e/world-spec-model-sweep.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "chai": "^6.3.0",
    "http-server": "^14.1.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "fantasy",
    "map",
    "generator",
    "procedural",
    "cartography",
    "testing"
  ],
  "author": "Azgaar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Azgaar/Fantasy-Map-Generator.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@openrouter/sdk": "^1.5.70",
    "alea": "^1.0.1",
    "compression": "^1.8.2",
    "d3": "^7.9.2",
    "delaunator": "^5.1.0",
    "dotenv": "^18.0.10",
    "dropbox": "^10.66.0",
    "express": "^5.3.0",
    "flatqueue": "^3.1.0",
    "jszip": "^3.10.2",
    "lineclip": "^2.0.0",
    "openai": "^7.53.0",
    "polylabel": "^2.1.0",
    "rgbquant": "^1.1.2",
    "simplify-js": "^1.2.4",
    "three": "^0.187.0",
    "three-subdivide": "^1.1.5",
    "tinymce": "^8.10.1",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
